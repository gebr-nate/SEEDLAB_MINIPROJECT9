// ---- Timing ----
const unsigned long desired_Ts_ms = 10;  // sample time (100 Hz loop)
const unsigned long RUN_TIME_MS = 5000;  // stop after 5 seconds
unsigned long last_time_ms;
unsigned long start_time_ms;
float current_time;                      // seconds since start

// ---- Pins (index 0 = motor 1, index 1 = motor 2) ----
const int enablePin = 4;
const int dirPin[2] = {7, 8};
const int pwmPin[2] = {9, 10};
const int encA[2]   = {2, 3};
const int encB[2]   = {5, 6};

// ---- Encoder ----
// Counting only RISING edges of channel A gives 1/4 of full quadrature.
const float COUNTS_PER_REV = 3200.0;
volatile long encoderCount[2] = {0, 0};
long prevPos_counts[2] = {0, 0};

// ---- Controller gains ----
float Kp = 11;             // inner velocity loop: volts per (rad/s) of speed error
float Kp_pos = 5.0;        // outer position loop: (rad/s) per rad of position error 
float Ki_pos = 1;        // outer position loop integral
const float MAX_SPEED = 8.0;          // cap on requested wheel speed [rad/s]
const float Battery_Voltage = 7.6;    // used to scale voltage into PWM

// ---- Controller state ----
float integral_error[2] = {0, 0};     // running integral of position error in rads, initialize to 0

int goal[2] = {0, 0};   // defaults to {0,0} until the first message arrives

// ---- Encoder ISRs: channel B level on A's rising edge gives direction ----
void encoderISR1() { encoderCount[0] += (digitalRead(encB[0]) == HIGH) ? 1 : -1; }
void encoderISR2() { encoderCount[1] += (digitalRead(encB[1]) == HIGH) ? 1 : -1; }

// ---- Read goal position from the Pi over serial ----
void readGoalFromPi() {
  static char buf[8];
  static int idx = 0;

  while (Serial.available() > 0) {
    char c = Serial.read();
    if (c == '\n') {
      if (idx >= 2 && (buf[0] == '0' || buf[0] == '1') && (buf[1] == '0' || buf[1] == '1')) {
        goal[0] = buf[0] - '0';
        goal[1] = buf[1] - '0';
      }
      idx = 0;  // reset for next message
    } else if (idx < (int)sizeof(buf) - 1) {
      buf[idx++] = c;
    }
  }
}

void setup() {
  pinMode(enablePin, OUTPUT);
  for (int i = 0; i < 2; i++) {
    pinMode(dirPin[i], OUTPUT);
    pinMode(pwmPin[i], OUTPUT);
    pinMode(encA[i], INPUT);
    pinMode(encB[i], INPUT);
  }
  attachInterrupt(digitalPinToInterrupt(encA[0]), encoderISR1, RISING);
  attachInterrupt(digitalPinToInterrupt(encA[1]), encoderISR2, RISING);
  digitalWrite(enablePin, HIGH);  // motor driver on

  Serial.begin(115200);
  last_time_ms = millis();
  start_time_ms = last_time_ms;
}

void loop() {
  float Ts = (float)desired_Ts_ms / 1000.0;          // sample time in seconds
  current_time = (float)(millis() - start_time_ms) / 1000.0;

  // ---- Check for a new goal position from the Pi ----
  readGoalFromPi();

  // ---- Convert the 0/1 goal bits into radians ----
  float desired_pos[2];
  desired_pos[0] = goal[0] * PI;
  desired_pos[1] = goal[1] * PI;

  float actual_pos[2], actual_speed[2];

  // Read encoders safely (ISRs can change the counts mid-read)
  long counts[2];
  noInterrupts();
  counts[0] = encoderCount[0];
  counts[1] = encoderCount[1];
  interrupts();

  for (int i = 0; i < 2; i++) {
    // ---- Position and velocity measurement ----
    actual_pos[i]   = 2 * PI * (float)counts[i] / COUNTS_PER_REV;                        // [rad]
    actual_speed[i] = 2 * PI * (float)(counts[i] - prevPos_counts[i]) / COUNTS_PER_REV / Ts; // [rad/s]
    prevPos_counts[i] = counts[i];

    // ---- Outer loop: PI position control -> desired speed ----
    float pos_error = desired_pos[i] - actual_pos[i];
    integral_error[i] += pos_error * Ts;
    float desired_speed = Kp_pos * pos_error + Ki_pos * integral_error[i];

    // Cap the requested speed
    if (desired_speed > MAX_SPEED || desired_speed < -MAX_SPEED) {
      integral_error[i] -= pos_error * Ts;
      desired_speed = constrain(desired_speed, -MAX_SPEED, MAX_SPEED);
    }

    float error = desired_speed - actual_speed[i]; // set p error
    float Voltage = Kp * error; // log voltage

    // ---- Output: sign sets direction, magnitude sets PWM ----
    digitalWrite(dirPin[i], (Voltage > 0) ? HIGH : LOW);
    unsigned int PWM = 255 * fabs(Voltage) / Battery_Voltage;
    analogWrite(pwmPin[i], min(PWM, 255));   // saturate at full battery voltage
  }
  // ---- Data logging ----
  Serial.print(current_time);   Serial.print("\t");
  Serial.print(desired_pos[0]); Serial.print("\t");
  Serial.print(actual_pos[0]);  Serial.print("\t");
  Serial.println(actual_pos[1]);
}
