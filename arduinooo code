/*
 * ============================================================================
 * File:        dual_motor_position_control.ino
 * Title:       Dual DC Motor Cascaded Position/Velocity Controller
 * Platform:    Arduino (ATmega328P-class board, e.g. Uno / Nano)
 * Serial:      115200 baud
 * ============================================================================
 *
 * PURPOSE
 * -------
 * Controls the angular position of two encoder-equipped DC motors (wheels)
 * using a cascaded control structure running at a fixed 100 Hz (10 ms) rate:
 *
 *   Outer loop : PI position controller  -> produces a desired wheel speed
 *                (rad/s), saturated at +/- MAX_SPEED with anti-windup.
 *   Inner loop : P velocity controller   -> produces a motor voltage command,
 *                converted to a PWM duty cycle based on the battery voltage.
 *
 * Each wheel has only two possible targets: 0 rad (goal bit = 0) or
 * PI rad / half a revolution (goal bit = 1).
 *
 * USAGE
 * -----
 * Open the Serial Monitor at 115200 baud, set line ending to "Newline" (or
 * "Both NL & CR"), and send a two-character goal string:
 *
 *   "00"  -> motor 1 to 0,  motor 2 to 0
 *   "01"  -> motor 1 to 0,  motor 2 to PI
 *   "10"  -> motor 1 to PI, motor 2 to 0
 *   "11"  -> motor 1 to PI, motor 2 to PI
 *
 * The first character is motor 1 (index 0), the second is motor 2 (index 1).
 * Any other input is ignored. A valid new goal resets the position-loop
 * integrators. The encoder zero position is wherever the wheels are when
 * the board powers up/resets.
 *
 * HARDWARE CONFIGURATION
 * ----------------------
 * Required hardware:
 *   - Arduino board with at least two external-interrupt pins (pins 2 and 3
 *     on an Uno/Nano) and two PWM outputs on pins 9 and 10.
 *   - Dual H-bridge motor driver with a shared enable input and, per
 *     channel, a direction input and a PWM (speed) input.
 *   - Two brushed DC motors with quadrature encoders (A/B channels).
 *   - Battery supply of approximately 7.6 V for the motor driver/motors
 *     (value used by the PWM scaling; update Battery_Voltage if different).
 *   - Common ground between Arduino, motor driver, and encoders.
 *
 * Pin map:
 *   Function              Motor 1 (idx 0)   Motor 2 (idx 1)   Shared
 *   --------------------  ----------------  ----------------  ---------
 *   Driver enable         -                 -                 D4
 *   Direction (dirPin)    D7                D8                -
 *   PWM speed (pwmPin)    D9                D10               -
 *   Encoder A (interrupt) D2                D3                -
 *   Encoder B             D5                D6                -
 *
 * Encoder: 800 counts per wheel revolution (COUNTS_PER_REV). Counting is
 * triggered on the RISING edge of channel A, with channel B read in the ISR
 * to determine direction.
 *
 * Motor orientation: Motor 2 is physically mounted in reverse, so its
 * encoder count sign and its direction-pin logic are both inverted in
 * software so that positive position means forward for both wheels.
 *
 * Notes:
 *   - Pins 2 and 3 are the only external-interrupt pins on ATmega328P
 *     boards, so the encoder A channels must stay on them.
 *   - Tuning parameters (Kp, Kp_pos, Ki_pos, MAX_SPEED, Battery_Voltage)
 *     are set in the "Controller gains" section below.
 * ============================================================================
 */

// ---- Timing ----
const unsigned long desired_Ts_ms = 10;   // sample time (100 Hz loop)
unsigned long last_time_ms;
unsigned long start_time_ms;
float current_time;                       // seconds since start

// ---- Logging (printing at 100 Hz makes the Serial Monitor hard to use) ----
const int LOG_EVERY = 5;                  // print every 5th sample (20 Hz)
int log_counter = 0;

// ---- Pins (index 0 = motor 1, index 1 = motor 2) ----
const int enablePin = 4;
const int dirPin[2] = {7, 8};
const int pwmPin[2] = {9, 10};
const int encA[2]   = {2, 3};
const int encB[2]   = {5, 6};

// ---- Encoder ----
const float COUNTS_PER_REV = 800.0;
volatile long encoderCount[2] = {0, 0};
long prevPos_counts[2] = {0, 0};

// ---- Controller gains ----
float Kp = 3;                    // inner velocity loop: volts per (rad/s)
float Kp_pos = 5.0;               // outer position loop: (rad/s) per rad
float Ki_pos = .5;                 // outer position loop integral
const float MAX_SPEED = 8.0;      // cap on requested wheel speed [rad/s]
const float Battery_Voltage = 7.6;

// ---- Controller state ----
float integral_error[2] = {0, 0};
int goal[2] = {0, 0};             // 0 or 1 for each wheel

// ---- Encoder ISRs ----
void encoderISR1() { encoderCount[0] += (digitalRead(encB[0]) == HIGH) ? 1 : -1; }
void encoderISR2() { encoderCount[1] += (digitalRead(encB[1]) == HIGH) ? -1 : 1; }

// ---- Read a two-bit goal like "01" from the Serial Monitor ----
void readGoalFromSerial() {
  static char buf[8];
  static int idx = 0;

  while (Serial.available() > 0) {
    char c = Serial.read();
    if (c == '\n' || c == '\r') {               // end of message
      if (idx == 2 && (buf[0] == '0' || buf[0] == '1') && (buf[1] == '0' || buf[1] == '1')) {
        goal[0] = buf[0] - '0';
        goal[1] = buf[1] - '0';
        integral_error[0] = 0;                  // fresh start for the new move
        integral_error[1] = 0;
      }
      idx = 0;
    } else if (idx < (int)sizeof(buf) - 1) {
      buf[idx++] = c;
    }
  }
}

void setup() {
  pinMode(enablePin, OUTPUT);
  for (int i = 0; i < 2; i++) {
    pinMode(dirPin[i], OUTPUT);
    pinMode(pwmPin[i], OUTPUT);
    pinMode(encA[i], INPUT);
    pinMode(encB[i], INPUT);
  }
  attachInterrupt(digitalPinToInterrupt(encA[0]), encoderISR1, RISING);
  attachInterrupt(digitalPinToInterrupt(encA[1]), encoderISR2, RISING);
  digitalWrite(enablePin, HIGH);                // motor driver on

  Serial.begin(115200);
  last_time_ms = millis();
  start_time_ms = last_time_ms;
}

void loop() {
  readGoalFromSerial();                         // check for typed input every pass

  // ---- Run the controller at a fixed 10 ms rate ----
  if (millis() - last_time_ms < desired_Ts_ms) return;
  last_time_ms += desired_Ts_ms;

  float Ts = (float)desired_Ts_ms / 1000.0;
  current_time = (float)(millis() - start_time_ms) / 1000.0;

  // ---- Goal bits -> radians ----
  float desired_pos[2];
  desired_pos[0] = goal[0] * PI;
  desired_pos[1] = goal[1] * PI;

  float actual_pos[2], actual_speed[2];

  long counts[2];
  noInterrupts();
  counts[0] = encoderCount[0];
  counts[1] = encoderCount[1];
  interrupts();

  for (int i = 0; i < 2; i++) {
    // ---- Measurements ----
    actual_pos[i]   = 2 * PI * (float)counts[i] / COUNTS_PER_REV;
    actual_speed[i] = 2 * PI * (float)(counts[i] - prevPos_counts[i]) / COUNTS_PER_REV / Ts;
    prevPos_counts[i] = counts[i];

    // ---- Outer loop: PI position -> desired speed ----
    float pos_error = desired_pos[i] - actual_pos[i];
    integral_error[i] += pos_error * Ts;
    float desired_speed = Kp_pos * pos_error + Ki_pos * integral_error[i];

    if (desired_speed > MAX_SPEED || desired_speed < -MAX_SPEED) {
      integral_error[i] -= pos_error * Ts;      // anti-windup
      desired_speed = constrain(desired_speed, -MAX_SPEED, MAX_SPEED);
    }

    // ---- Inner loop: P velocity -> voltage ----
    float error = desired_speed - actual_speed[i];
    float Voltage = Kp * error;

    // ---- Output ----
    if (i == 0) {
    // Motor 0 stays normal
       digitalWrite(dirPin[i], (Voltage > 0) ? HIGH : LOW);
    }
    else {
    // Motor 1 is physically reversed
      digitalWrite(dirPin[i], (Voltage > 0) ? LOW : HIGH);
    }
    unsigned int PWM = 255 * fabs(Voltage) / Battery_Voltage;
    analogWrite(pwmPin[i], min(PWM, 255));
  }
}
