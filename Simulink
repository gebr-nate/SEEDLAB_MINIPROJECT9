%% Closed-Loop Motor POSITION Control: Simulation vs. Experiment

%% Laplace variable (needed for the PI(s) block, which is defined
%% symbolically in terms of s, e.g. Kp*error + Ki/s*error)
s = tf('s');

%% Motor Model Parameters (from system ID, Section 3.3)
K = 0.364;      % DC gain [rad/Vs]
sigma = 18;     % time constant reciprocal [1/s]

%% Inner-Loop Velocity Controller (reused from Assignment 2a)
Kp_vel = 11;    % proportional velocity gain, set inside the Velocity Subsystem

%% Outer-Loop Position Controller (PI, not full PID)
% These names MUST match exactly what's typed into the PI(s) block's
% Gain fields in Simulink - it's expecting bare "Kp" and "Ki".
Kp = 5;     % matches Kp_pos = 5.0 used on the Arduino
Ki = 1;     % matches Ki_pos = 1 used on the Arduino

%% Run Simulation
open_system('PI_control')          % open the Simulink model
out = sim('PI_control');           % run it, results stored in out

%% Load Experimental Data
% Columns as actually logged by the Arduino:
%   col1 = time, col2 = desired_pos[0], col3 = actual_pos[0], col4 = actual_pos[1]
% Note: voltage and velocity are NOT logged by the current Arduino code,
% so only a position comparison is possible with this data.
data = readmatrix('rawdata.txt');

%% Plot Simulated vs. Experimental Results
figure

% Plot 1: Desired Position (commanded step, sim vs. Arduino)
subplot(2,1,1)
plot(out.DesiredPosition,'--','linewidth',2)
hold on
plot(data(:,1), data(:,2), 'linewidth', 2) % col1=time, col2=desired_pos[0]
legend('Simulated','Experimental','location','southeast')
hold off
xlabel('Time (s)')
ylabel('Desired Position (rad)')
title('Desired Position: Simulated vs. Experimental')

% Plot 2: Position (simulated position vs. actual wheel position)
subplot(2,1,2)
plot(out.Position,'--','linewidth',2)
hold on
plot(data(:,1), data(:,3), 'linewidth', 2) % col3=actual_pos[0]
legend('Simulated','Experimental (wheel 0)','location','southeast')
hold off
xlabel('Time (s)')
ylabel('Position (rad)')
title('Closed-Loop Position: Simulated vs. Experimental')

