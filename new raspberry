// ---- Timing ----
const unsigned long desired_Ts_ms = 10;  // sample time (100 Hz loop)
unsigned long last_time_ms;
unsigned long start_time_ms;
float current_time;                      // seconds since start

// ---- Pins (index 0 = motor 1, index 1 = motor 2) ----
const int enablePin = 4;
const int dirPin[2] = {7, 8};
const int pwmPin[2] = {9, 10};
const int encA[2]   = {2, 3};
const int encB[2]   = {5, 6};

// ---- Encoder ----
const float COUNTS_PER_REV = 3200.0;
volatile long encoderCount[2] = {0, 0};
long prevPos_counts[2] = {0, 0};

// ---- Controller gains ----
float Kp = 11;
float Kp_pos = 5.0;
float Ki_pos = 1;
const float MAX_SPEED = 8.0;
const float Battery_Voltage = 7.6;

// ---- Settling criteria (when is a move "done"?) ----
const float POS_TOL_RAD        = 0.05;   // within ~3 degrees of target
const float SPEED_TOL_RAD_S    = 0.2;    // essentially stopped
const unsigned long SETTLE_TIME_MS = 200; // must stay settled this long
const bool HOLD_POSITION_WHEN_IDLE = false; // true = keep controller running after move

// ---- State machine ----
enum State { IDLE, MOVING };
State state = IDLE;
bool settling = false;
unsigned long settle_start_ms = 0;

// ---- Controller state ----
float integral_error[2] = {0, 0};

int goal[2]     = {0, 0};  // goal currently being executed / last executed
int incoming[2] = {0, 0};  // most recent quadrant received from the Pi

// ---- Encoder ISRs ----
void encoderISR1() { encoderCount[0] += (digitalRead(encB[0]) == HIGH) ? 1 : -1; }
void encoderISR2() { encoderCount[1] += (digitalRead(encB[1]) == HIGH) ? 1 : -1; }

// ---- Read quadrant from the Pi (stored in incoming, NOT acted on directly) ----
void readGoalFromPi() {
  static char buf[8];
  static int idx = 0;

  while (Serial.available() > 0) {
    char c = Serial.read();
    if (c == '\n') {
      if (idx >= 2 && (buf[0] == '0' || buf[0] == '1') && (buf[1] == '0' || buf[1] == '1')) {
        incoming[0] = buf[0] - '0';
        incoming[1] = buf[1] - '0';
      }
      idx = 0;
    } else if (idx < (int)sizeof(buf) - 1) {
      buf[idx++] = c;
    }
  }
}

void setup() {
  pinMode(enablePin, OUTPUT);
  for (int i = 0; i < 2; i++) {
    pinMode(dirPin[i], OUTPUT);
    pinMode(pwmPin[i], OUTPUT);
    pinMode(encA[i], INPUT);
    pinMode(encB[i], INPUT);
  }
  attachInterrupt(digitalPinToInterrupt(encA[0]), encoderISR1, RISING);
  attachInterrupt(digitalPinToInterrupt(encA[1]), encoderISR2, RISING);
  digitalWrite(enablePin, HIGH);

  Serial.begin(115200);
  last_time_ms = millis();
  start_time_ms = last_time_ms;
}

void loop() {
  // Always listen to the Pi, even between control ticks
  readGoalFromPi();

  // ---- Fixed-rate control loop (the speed calc assumes Ts is real) ----
  if (millis() - last_time_ms < desired_Ts_ms) return;
  last_time_ms += desired_Ts_ms;

  float Ts = (float)desired_Ts_ms / 1000.0;
  current_time = (float)(millis() - start_time_ms) / 1000.0;

  // ---- IDLE: start a move only when a DIFFERENT quadrant has been seen ----
  if (state == IDLE && (incoming[0] != goal[0] || incoming[1] != goal[1])) {
    goal[0] = incoming[0];
    goal[1] = incoming[1];
    integral_error[0] = 0;
    integral_error[1] = 0;
    settling = false;
    state = MOVING;
  }

  float desired_pos[2];
  desired_pos[0] = goal[0] * PI;
  desired_pos[1] = goal[1] * PI;

  float actual_pos[2], actual_speed[2];

  long counts[2];
  noInterrupts();
  counts[0] = encoderCount[0];
  counts[1] = encoderCount[1];
  interrupts();

  bool allSettled = true;

  for (int i = 0; i < 2; i++) {
    // ---- Measurements (always updated so speed stays valid) ----
    actual_pos[i]   = 2 * PI * (float)counts[i] / COUNTS_PER_REV;
    actual_speed[i] = 2 * PI * (float)(counts[i] - prevPos_counts[i]) / COUNTS_PER_REV / Ts;
    prevPos_counts[i] = counts[i];

    float pos_error = desired_pos[i] - actual_pos[i];

    if (fabs(pos_error) > POS_TOL_RAD || fabs(actual_speed[i]) > SPEED_TOL_RAD_S) {
      allSettled = false;
    }

    // ---- Idle and not holding: motors off, nothing to control ----
    if (state == IDLE && !HOLD_POSITION_WHEN_IDLE) {
      analogWrite(pwmPin[i], 0);
      continue;
    }

    // ---- Outer loop: PI position control -> desired speed ----
    integral_error[i] += pos_error * Ts;
    float desired_speed = Kp_pos * pos_error + Ki_pos * integral_error[i];

    if (desired_speed > MAX_SPEED || desired_speed < -MAX_SPEED) {
      integral_error[i] -= pos_error * Ts;  // anti-windup
      desired_speed = constrain(desired_speed, -MAX_SPEED, MAX_SPEED);
    }

    // ---- Inner loop: P velocity control -> voltage ----
    float error = desired_speed - actual_speed[i];
    float Voltage = Kp * error;

    digitalWrite(dirPin[i], (Voltage > 0) ? HIGH : LOW);
    unsigned int PWM = 255 * fabs(Voltage) / Battery_Voltage;
    analogWrite(pwmPin[i], min(PWM, 255));
  }

  // ---- Move complete? Require "settled" to persist for SETTLE_TIME_MS ----
  if (state == MOVING) {
    if (allSettled) {
      if (!settling) {
        settling = true;
        settle_start_ms = millis();
      } else if (millis() - settle_start_ms >= SETTLE_TIME_MS) {
        state = IDLE;   // done; wait for a different quadrant
        settling = false;
        if (!HOLD_POSITION_WHEN_IDLE) {
          integral_error[0] = 0;
          integral_error[1] = 0;
        }
      }
    } else {
      settling = false;
    }
  }

  // ---- Data logging ----
  Serial.print(current_time);   Serial.print("\t");
  Serial.print(desired_pos[0]); Serial.print("\t");
  Serial.print(actual_pos[0]);  Serial.print("\t");
  Serial.println(actual_pos[1]);
}
