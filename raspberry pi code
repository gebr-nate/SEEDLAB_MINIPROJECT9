"""
===============================================================================
File:        aruco_quadrant_wheel_control.py
Title:       ArUco Marker Quadrant Tracker -> Arduino Wheel Goal Sender
Platform:    Raspberry Pi (Linux, Python 3) with CircuitPython Blinka
Serial:      115200 baud to Arduino on /dev/ttyACM0
===============================================================================

PURPOSE
-------
Uses a camera and OpenCV to detect an ArUco marker (DICT_6X6_50), works out
which quadrant of the camera image the marker's center is in, and sends the
matching two-bit wheel goal to an Arduino running the dual-motor position
controller (dual_motor_position_control.ino). The goal currently being sent
is also shown on a 16x2 character LCD.

The 320x240 image is split into four quadrants by a vertical line at x = 160
and a horizontal line at y = 120:

    Quadrant   Marker center         left_goal  right_goal  Sent to Arduino
    --------   -------------------   ---------  ----------  ---------------
    NW         x < 160,  y < 120         0          1            "10"
    NE         x >= 160, y < 120         0          0            "00"
    SW         x < 160,  y >= 120        1          1            "11"
    SE         x >= 160, y >= 120        1          0            "01"

Each goal bit means: 0 = wheel at 0 rad, 1 = wheel at PI rad.

The command is written as "<right_goal><left_goal>\n". The Arduino reads the
first character as motor 1 and the second as motor 2, so motor 1 is the right
wheel and motor 2 is the left wheel.

Only the first detected marker (corners[0]) is used. If no marker is seen,
the last goal is kept and nothing new is sent. The program only sends a new
command when the LCD message (the goal pair) changes.

USAGE
-----
1. Upload dual_motor_position_control.ino to the Arduino and connect it to
   the Raspberry Pi over USB.
2. Run this script on the Pi with a display attached (cv2.imshow is used):
       python3 aruco_quadrant_wheel_control.py
3. Hold an ArUco marker (6x6, ID within the 50-marker dictionary) in front
   of the camera. Move it between quadrants to change the wheel goals.
4. Press 'q' in the camera window to stop. The camera and serial port are
   released and windows are closed on exit.

HARDWARE CONFIGURATION
----------------------
Required hardware:
  - Raspberry Pi with I2C enabled (raspi-config -> Interface Options -> I2C)
    and a desktop/display for the preview window.
  - USB camera (opened as device index 0), configured to 320x240 at 30 FPS
    with a buffer size of 1 to keep latency low.
  - Adafruit-style 16x2 RGB character LCD with I2C backpack, driven through
    the adafruit_character_lcd.character_lcd_rgb_i2c library on the Pi's
    default I2C bus (board.I2C(): SDA/SCL pins).
  - Arduino (see dual_motor_position_control.ino) connected by USB; it
    enumerates as /dev/ttyACM0 and communicates at 115200 baud. The script
    waits 2 s after opening the port to allow the Arduino to reset.
  - Printed ArUco marker from the DICT_6X6_50 dictionary.

Connections:
  Raspberry Pi  <--USB-->  Arduino (serial, /dev/ttyACM0, 115200 baud)
  Raspberry Pi  <--USB-->  Camera (device index 0)
  Raspberry Pi  <--I2C-->  16x2 RGB character LCD (SDA, SCL, power, GND)

Software dependencies:
  - opencv-contrib-python (provides cv2.aruco)
  - adafruit-circuitpython-charlcd
  - adafruit-blinka (provides board / busio)
  - pyserial

Notes:
  - If the Arduino appears on a different port, update the serial path in
    the "arduino serial connection" section.
  - The LCD is updated from a background daemon thread fed by a queue, so
    slow I2C writes do not stall the camera loop.
  - minMarkerPerimeterRate is set low (0.01) so small or distant markers
    are still detected at this low resolution.
===============================================================================
"""

#Mini project - CV code that dettects aruco marker and creates
# quadrants, whichever quadrant marker is in determines wheel position and
#sends to arduino



import cv2
from cv2 import aruco
from time import sleep#for cam stuff
import threading
import queue
import board
import busio#lcd libraries
import adafruit_character_lcd.character_lcd_rgb_i2c as character_lcd
import serial #using serial connection

#lcd set
import board
lcd_queue = queue.Queue()#lcd message queue for threading

lcd_columns = 16
lcd_rows = 2#lcd size

i2c = board.I2C()#i2c connection

lcd = character_lcd.Character_LCD_RGB_I2C(
    i2c,
    lcd_columns,
    lcd_rows
)#tells adafruit lib to create lcd that uses i2c and is 16x2

aruco_dict=aruco.getPredefinedDictionary(aruco.DICT_6X6_50) #aruco dic
parameters=aruco.DetectorParameters() #detector parameters
parameters.minMarkerPerimeterRate = 0.01#controls min marker consideration

def update_lcd():
    while True:#doesnt end on its own
            message = lcd_queue.get()#get queue message
            lcd.message = message#display message
#lcd thread start
lcd_thread = threading.Thread(target=update_lcd)#new thread whose job is to run the updatelcd func
lcd_thread.daemon = True #keep program alive
lcd_thread.start()


#arduino serial connection
arduino = serial.Serial('/dev/ttyACM0',115200, timeout=1, write_timeout=1)
sleep(2)

#camera set
camera=cv2.VideoCapture(0)#open cam
camera.set(cv2.CAP_PROP_FRAME_WIDTH, 320)
camera.set(cv2.CAP_PROP_FRAME_HEIGHT, 240)#image is 320x240 pixels
camera.set(cv2.CAP_PROP_FPS, 30)
camera.set(cv2.CAP_PROP_BUFFERSIZE, 1)

sleep(0.5) #camera time to start
last_message=""#used later so dont need to keep clearing and rewriting lcd

#cam loop for aruco detect+greyscale
while True:
    ret,frame=camera.read()#take pic
    if not ret:
        print("Didn't read camera")#if didnt take pic
        continue
    #convert to greyscale
    grey=cv2.cvtColor(frame,cv2.COLOR_BGR2GRAY)
    #detect aruco markers using grey,aruco dict, and parameter
    corners,ids,rejected=aruco.detectMarkers(
        grey,
        aruco_dict,
        parameters=parameters
        )

    #make copy so can draw boxes on markers
    overlay = frame.copy()
    #quadrant lines on cam
    cv2.line(overlay, (160, 0), (160, 240), (0,255,0), 2)
    cv2.line(overlay, (0, 120), (320, 120), (0,255,0), 2)
    
    #see if markers found, ids contains data if opencv found mmkr
    if ids is not None:
        ids=ids.flatten()#changes to one dim arrayy
        #print("marker ids: ", ids)
        aruco.drawDetectedMarkers(overlay,corners,ids)#draws outline around markers in overlay

        marker_corners = corners[0][0]
        #calc center of marker
        center_x=int(marker_corners[:,0].mean())
        center_y=int(marker_corners[:,1].mean())
        #print("marker center:", center_x, center_y)
        
        #center point on image
        cv2.circle(overlay, (center_x, center_y), 5, (0, 0, 255), -1)

        #determining quadrant
        if center_x < 160 and center_y < 120:#image is 320X240
            quadrant = "NW"
            left_goal = 0
            right_goal = 1

        elif center_x >= 160 and center_y < 120:
            quadrant = "NE"
            left_goal = 0
            right_goal = 0

        elif center_x < 160 and center_y >= 120:
            quadrant = "SW"
            left_goal = 1
            right_goal = 1

        else:
            quadrant = "SE"
            left_goal = 1
            right_goal = 0
        #print("quadrant", quadrant)
        #print("goal position:", left_goal, right_goal)
        
        #convert to text for lcd
        message= "Goal Position:\n{} {}".format(left_goal, right_goal)
       

    else:
        #print("no markers found")
        message=last_message
        
    # only send to lcd if message has changed
    if message != last_message:
        lcd_queue.put(message)#main thread puts message
        
    #send wheel goals to arduino
        if ids is not None:#make sure marker exisits
            command = "{}{}\n".format(right_goal,left_goal)#serial to the arduino
            try:
                arduino.write(command.encode())#convert to bytes, then send to arduino
                print("sent to Arduino", command.strip())

            except serial.SerialTimeoutException:#for timeout
                print("write to arduino time out")
        last_message=message#lcd thread displays

    cv2.imshow("aruco detection", overlay)#display cam image
    k=cv2.waitKey(1)&0xFF#wait 1ms and see if q pressed
    if k==ord('q'):#stop program when q press
        break

camera.release()
arduino.close()
cv2.destroyAllWindows()
