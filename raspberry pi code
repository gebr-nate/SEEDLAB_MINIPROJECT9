import cv2
from cv2 import aruco
from time import sleep#for cam stuff
import threading
import queue
import board
import busio#lcd libraries
import adafruit_character_lcd.character_lcd_rgb_i2c as character_lcd
import serial #using serial connection

#lcd set
import board
lcd_queue = queue.Queue()

lcd_columns = 16
lcd_rows = 2#lcd size

i2c = board.I2C()#i2c connection

lcd = character_lcd.Character_LCD_RGB_I2C(
    i2c,
    lcd_columns,
    lcd_rows
)#tells adafruit lib to create lcd that uses i2c and is 16x2

aruco_dict=aruco.getPredefinedDictionary(aruco.DICT_6X6_50) #aruco dic
parameters=aruco.DetectorParameters() #detector parameters
parameters.minMarkerPerimeterRate = 0.01#controls min marker consideration

def update_lcd():
    while True:
        if not lcd_queue.empty():
            message = lcd_queue.get()
            lcd.clear()
            lcd.message = message
#lcd thread start
lcd_thread = threading.Thread(target=update_lcd)
lcd_thread.daemon = True
lcd_thread.start()


#arduino serial connection
arduino = serial.Serial('/dev/ttyACM0',115200, timeout=1, write_timeout=1)
sleep(2)

#camera set
camera=cv2.VideoCapture(0)#open cam
camera.set(cv2.CAP_PROP_FRAME_WIDTH, 640)
camera.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)#image is 640x480 pixels

sleep(0.5) #camera time to start
last_message=""#used later so dont need to keep clearing and rewriting lcd


while True:
    ret,frame=camera.read()#take pic
    if not ret:
        print("Didn't read camera")#if didnt take pic
        continue
    #convert to greyscale
    grey=cv2.cvtColor(frame,cv2.COLOR_BGR2GRAY)
    #detect aruco markers using grey,aruco dict, and parameter
    corners,ids,rejected=aruco.detectMarkers(
        grey,
        aruco_dict,
        parameters=parameters
        )

    #make copy so can draw boxes on markers
    overlay = frame.copy()
    #quadrant lines
    cv2.line(overlay, (320, 0 ), (320, 480), (0,255,0), 2)
    cv2.line(overlay, (0, 240), (640, 240), (0,255,0), 2)
    
    #see if markers found, ids contains data if opencv found mmkr
    if ids is not None:
        ids=ids.flatten()#changes to one dim arrayy
        print("marker ids: ", ids)
        aruco.drawDetectedMarkers(overlay,corners,ids)#draws outline around markers in overlay

        marker_corners = corners[0][0]
        #calc center of marker
        center_x=int(marker_corners[:,0].mean())
        center_y=int(marker_corners[:,1].mean())
        print("marker center:", center_x, center_y)
        #center point on image
        cv2.circle(overlay, (center_x, center_y), 5, (0, 0, 255), -1)

        #determining quadrant
        if center_x < 320 and center_y < 240:
            quadrant = "NW"
            left_goal = 0
            right_goal = 1
        elif center_x >= 320 and center_y < 240:
            quadrant = "NE"
            left_goal = 0
            right_goal = 0
        elif center_x < 320 and center_y >= 240:
            quadrant = "SW"
            left_goal = 1
            right_goal = 1
        else:
            quadrant = "SE"
            left_goal = 1
            right_goal = 0
        print("quadrant", quadrant)
        print("goal position:", left_goal, right_goal)
        
        #convert to text for lcd
        message= "Goal Position:\n{} {}".format(left_goal, right_goal)
       

    else:
        print("no markers found")
        message="no markers\nfound"
    # only send to lcd if message has changed
    if message != last_message:
        lcd_queue.put(message)
    #send wheel goals to arduino
        if ids is not None:
            command = "{}{}\n".format(left_goal,right_goal)
            arduino.write(command.encode())
            print("sent to Arduino", command.strip())
        last_message=message

    cv2.imshow("aruco detection", overlay)#display cam image
    k=cv2.waitKey(1)&0xFF#wait 1ms and see if q pressed
    if k==ord('q'):#stop program when q press
        break

camera.release()
arduino.close()
cv2.destroyAllWindows()
        

